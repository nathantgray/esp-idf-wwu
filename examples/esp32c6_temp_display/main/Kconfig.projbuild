menu "Temperature Display Configuration"

    menu "Provisioning Service"
        config PROV_TRANSPORT_BLE
            bool "SoftAP + BLE"
            default y
            help
                If this option is enabled, use both BLE and SoftAP for provisioning.

        config PROV_TRANSPORT_SOFTAP
            bool "SoftAP only"
            depends on !PROV_TRANSPORT_BLE
            default y
            help
                If this option is enabled, use SoftAP only for provisioning.

        config EXAMPLE_PROV_SECURITY_VERSION
            int
            default 1
            help
                The example uses Wi-Fi Provisioning Manager's auto-start feature.

        config EXAMPLE_PROV_SECURITY_VERSION_2
            bool "Use Security Version 2 for Provisioning"
            default y
            help
                Use Wi-Fi Provisioning Manager's Security Version 2 for provisioning.

        config EXAMPLE_PROV_SEC2_DEV_MODE
            bool "Use Security Version 2 Dev Mode"
            depends on EXAMPLE_PROV_SECURITY_VERSION_2
            default y
            help
                Use Wi-Fi Provisioning Manager's Security Version 2 dev mode.

        config PROV_SERVICE_NAME
            string "Service Name"
            default "TempDisplay"
            help
                Name of the provisioning service for SoftAP SSID.

        config PROV_POP
            string "Proof of Possession"
            default "abcd1234"
            help
                Proof of Possession for provisioning security.

    endmenu

    menu "NeoPixel Display Configuration"
        config NEOPIXEL_GPIO
            int "NeoPixel Data GPIO"
            default 8
            range 0 48
            help
                GPIO pin number for NeoPixel data line on ESP32-C6.
                Recommended: GPIO 8

        config NEOPIXEL_BRIGHTNESS
            int "Initial Brightness (0-255)"
            default 200
            range 0 255
            help
                Initial brightness level for NeoPixel LEDs.

    endmenu

    menu "MQTT Configuration"
        config MQTT_BROKER_URI
            string "MQTT Broker URI"
            default "mqtt://homeassistant.local:1883"
            help
                Full URI of MQTT broker (e.g., mqtt://hostname:1883 or mqtts://hostname:8883)

        config MQTT_USERNAME
            string "MQTT Username"
            default "mqtt_user"
            help
                Username for MQTT broker authentication

        config MQTT_PASSWORD
            string "MQTT Password"
            default "mqtt_password"
            help
                Password for MQTT broker authentication

        config MQTT_TEMP_TOPIC
            string "Temperature Topic"
            default "home/livingroom/temperature"
            help
                MQTT topic to subscribe to for temperature readings.
                Home Assistant entity example: sensor.living_room_temperature
                Use the state topic from the sensor's MQTT Discovery configuration.

    endmenu

    menu "WiFi Configuration"
        config EXAMPLE_WIFI_SSID
            string "WiFi SSID"
            default ""
            help
                Optional: Pre-configured WiFi SSID. Leave empty to use provisioning.

        config EXAMPLE_WIFI_PASSWORD
            string "WiFi Password"
            default ""
            help
                Optional: Pre-configured WiFi password. Leave empty to use provisioning.

    endmenu

endmenu
